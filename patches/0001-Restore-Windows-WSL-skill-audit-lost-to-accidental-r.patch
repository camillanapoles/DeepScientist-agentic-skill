+    SKILL_ROOT / "agents",
+    SKILL_ROOT / "references",
+    SKILL_ROOT / "scripts",
+    SKILL_ROOT / "orchestration",
+    SKILL_ROOT / "checklists",
+)
+
+REQUIRED_PHRASES = {
+    SKILL_MD: (
+        "name: deepscientist-windows-wsl-setup",
